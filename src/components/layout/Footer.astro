---
/** Site footer: identity, navigation columns, availability and legal line. */
import Icon from '@/components/ui/Icon.astro';
import Button from '@/components/ui/Button.astro';
import { footerNav } from '@/config/navigation';
import { personal, socials } from '@/config/personal';
import { site } from '@/config/site';
import { href } from '@/lib/utils';

const year = new Date().getFullYear();
---

<footer class="relative mt-auto overflow-hidden border-t border-line bg-canvas-alt">
  <!-- Ambient wash so the footer does not read as a dead zone. -->
  <div
    class="aurora -bottom-40 left-1/4 h-72 w-[36rem] opacity-25"
    style="background:radial-gradient(circle,var(--c-accent),transparent 65%)"
    aria-hidden="true"
  >
  </div>

  <div class="shell relative">
    <!-- Top: identity + nav -->
    <div class="grid gap-12 py-16 lg:grid-cols-[1.4fr_2fr] lg:gap-20">
      <div class="flex flex-col gap-6">
        <a href={href('/')} class="flex w-fit items-center gap-3" aria-label={`${personal.fullName} — home`}>
          <span class="grid h-10 w-10 place-items-center rounded-xl bg-accent font-display text-base font-bold text-accent-contrast">
            SA
          </span>
          <span class="font-display text-lg font-semibold tracking-tight text-body">
            {personal.fullName}
          </span>
        </a>

        <p class="max-w-sm text-[0.95rem] leading-relaxed text-muted">
          {personal.short}
        </p>

        {
          personal.availability.open && (
            <div class="flex w-fit items-center gap-2.5 rounded-full border border-success/25 bg-success/10 px-3.5 py-1.5">
              <span class="relative flex h-2 w-2">
                <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-success opacity-70" />
                <span class="relative inline-flex h-2 w-2 rounded-full bg-success" />
              </span>
              <span class="text-[0.8rem] font-medium text-success">
                {personal.availability.label}
              </span>
            </div>
          )
        }

        <ul class="flex items-center gap-2.5" aria-label="Social profiles">
          {
            socials.map((social) => (
              <li>
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer me"
                  class="grid h-10 w-10 place-items-center rounded-full border border-line text-muted transition-[color,border-color,transform] duration-200 hover:-translate-y-0.5 hover:border-accent/50 hover:text-accent"
                  aria-label={`${personal.firstName} on ${social.label}`}
                >
                  <Icon name={social.icon} size={17} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="grid gap-10 sm:grid-cols-3">
        {
          footerNav.map((column) => (
            <nav aria-label={column.title}>
              <h2 class="font-mono text-[0.7rem] uppercase tracking-[0.16em] text-subtle">
                {column.title}
              </h2>
              <ul class="mt-4 flex flex-col gap-2.5">
                {column.items.map((item) => (
                  <li>
                    <a
                      href={href(item.href)}
                      class="group inline-flex items-center gap-1.5 text-[0.9rem] text-muted transition-colors duration-200 hover:text-body"
                    >
                      <span class="relative">
                        {item.label}
                        <span class="absolute -bottom-0.5 left-0 h-px w-0 bg-accent transition-[width] duration-300 ease-[var(--ease-quint)] group-hover:w-full" />
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          ))
        }
      </div>
    </div>

    <!-- CTA strip -->
    <div
      class="card card-sheen mb-14 flex flex-col items-start justify-between gap-6 overflow-hidden p-8 sm:p-10 md:flex-row md:items-center"
    >
      <div class="max-w-lg">
        <h2 class="text-h3 font-display text-body">
          Have a project in mind?
        </h2>
        <p class="mt-2 text-[0.95rem] leading-relaxed text-muted">
          Tell me what you are building. You will get a considered reply — with an honest
          view on scope, timeline and cost — within one business day.
        </p>
      </div>
      <div class="flex shrink-0 flex-wrap gap-3">
        <Button href="/contact" icon="arrow-right">Start a conversation</Button>
        <Button href={`mailto:${personal.email}`} variant="outline" icon="mail" iconPosition="left">
          Email directly
        </Button>
      </div>
    </div>

    <!-- Legal -->
    <div
      class="flex flex-col items-center justify-between gap-4 border-t border-line py-7 text-[0.82rem] text-subtle sm:flex-row"
    >
      <p>© {year} {personal.fullName}. All rights reserved.</p>

      <div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2">
        <span class="inline-flex items-center gap-1.5">
          <Icon name="map-pin" size={14} />
          {personal.location}
        </span>
        <a href={href('/privacy')} class="transition-colors hover:text-body">Privacy Policy</a>
        <span class="hidden items-center gap-1.5 sm:inline-flex">
          Built with
          <a
            href="https://astro.build"
            target="_blank"
            rel="noopener noreferrer"
            class="text-muted transition-colors hover:text-accent">Astro</a
          >
          <span aria-hidden="true">·</span>
          <span class="sr-only">Site version</span>
          <span class="font-mono">{site.shortName}</span>
        </span>
      </div>
    </div>
  </div>
</footer>
