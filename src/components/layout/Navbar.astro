---
/**
 * Sticky site header.
 *
 * - Transparent at the top of the page, frosted once scrolled (adds contrast
 *   without a hard edge).
 * - Active link is derived server-side from the current pathname, so
 *   highlighting is correct before JS runs.
 * - Mobile menu is a focus-trapped dialog-style panel.
 */
import Icon from '@/components/ui/Icon.astro';
import ThemeToggle from '@/components/ui/ThemeToggle.astro';
import Button from '@/components/ui/Button.astro';
import { mainNav } from '@/config/navigation';
import { personal } from '@/config/personal';
import { href, isActivePath, cx } from '@/lib/utils';

const pathname = Astro.url.pathname;
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-[65] transition-[background-color,border-color,backdrop-filter] duration-300 ease-[var(--ease-quint)] border-b border-transparent data-[stuck=true]:border-line data-[stuck=true]:bg-glass data-[stuck=true]:backdrop-blur-xl data-[stuck=true]:backdrop-saturate-150"
  data-stuck="false"
>
  <div class="shell-wide flex h-[var(--header-h)] items-center justify-between gap-6">
    <!-- Wordmark -->
    <a
      href={href('/')}
      class="group flex shrink-0 items-center gap-2.5 rounded-lg"
      aria-label={`${personal.fullName} — home`}
    >
      <span
        class="relative grid h-9 w-9 place-items-center rounded-xl bg-accent font-display text-[0.95rem] font-bold text-accent-contrast transition-transform duration-300 ease-[var(--ease-bounce)] group-hover:rotate-[-6deg] group-hover:scale-105"
      >
        SA
      </span>
      <span class="hidden flex-col leading-none sm:flex">
        <span class="font-display text-[0.95rem] font-semibold tracking-tight text-body">
          {personal.fullName}
        </span>
        <span class="mt-1 font-mono text-[0.62rem] uppercase tracking-[0.18em] text-subtle">
          {personal.role}
        </span>
      </span>
    </a>

    <!-- Desktop navigation -->
    <nav class="hidden lg:block" aria-label="Primary">
      <ul class="flex items-center gap-1">
        {
          mainNav.map((item) => {
            const active = isActivePath(pathname, item.href);
            return (
              <li>
                <a
                  href={href(item.href)}
                  aria-current={active ? 'page' : undefined}
                  class={cx(
                    'nav-link relative rounded-full px-3.5 py-2 text-[0.875rem] font-medium transition-colors duration-200',
                    active ? 'text-body' : 'text-muted hover:text-body',
                  )}
                  data-active={active ? 'true' : 'false'}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <!-- Actions -->
    <div class="flex items-center gap-2">
      <ThemeToggle />

      <div class="hidden sm:block">
        <Button href="/contact" size="sm" variant="primary" icon="arrow-right">
          Start a project
        </Button>
      </div>

      <button
        type="button"
        id="menu-toggle"
        class="grid h-10 w-10 place-items-center rounded-full border border-line text-body transition-colors hover:border-line-strong lg:hidden"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Icon name="menu" size={20} class="menu-open-icon" />
        <Icon name="close" size={20} class="menu-close-icon hidden" />
      </button>
    </div>
  </div>
</header>

<!-- Mobile panel -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-[64] hidden lg:hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Site navigation"
>
  <div class="menu-backdrop absolute inset-0 bg-canvas/80 backdrop-blur-sm" data-close></div>

  <nav
    class="menu-panel glass absolute inset-x-3 top-[calc(var(--header-h)+0.5rem)] max-h-[calc(100dvh-var(--header-h)-1.5rem)] overflow-y-auto rounded-[1.5rem] p-3 shadow-float"
    aria-label="Mobile"
  >
    <ul class="flex flex-col gap-0.5">
      {
        mainNav.map((item, i) => {
          const active = isActivePath(pathname, item.href);
          return (
            <li>
              <a
                href={href(item.href)}
                aria-current={active ? 'page' : undefined}
                class={cx(
                  'menu-item flex items-center justify-between gap-4 rounded-2xl px-4 py-3.5 transition-colors duration-200',
                  active ? 'bg-accent-soft text-accent' : 'text-body hover:bg-overlay',
                )}
                style={`--i:${i}`}
              >
                <span class="flex flex-col gap-0.5">
                  <span class="font-display text-[1.05rem] font-semibold">{item.label}</span>
                  {item.description && (
                    <span class="text-[0.78rem] text-subtle">{item.description}</span>
                  )}
                </span>
                <Icon name="arrow-up-right" size={16} class="shrink-0 opacity-50" />
              </a>
            </li>
          );
        })
      }
    </ul>

    <div class="mt-3 border-t border-line p-3">
      <Button href="/contact" full size="md" icon="arrow-right">Start a project</Button>
    </div>
  </nav>
</div>

<style>
  /* Underline that grows from the centre on hover and stays for the active page. */
  .nav-link::after {
    content: '';
    position: absolute;
    inset-inline: 0.875rem;
    bottom: 0.35rem;
    height: 1.5px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--c-accent), var(--c-second));
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 260ms var(--ease-out-quint);
  }

  .nav-link:hover::after,
  .nav-link[data-active='true']::after {
    transform: scaleX(1);
  }

  /* Staggered entrance for the mobile items. */
  #mobile-menu[data-open='true'] .menu-panel {
    animation: menu-in 320ms var(--ease-spring) both;
  }

  #mobile-menu[data-open='true'] .menu-item {
    animation: item-in 300ms var(--ease-out-quint) both;
    animation-delay: calc(60ms + var(--i) * 35ms);
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-10px) scale(0.98);
    }
  }

  @keyframes item-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #mobile-menu[data-open='true'] .menu-panel,
    #mobile-menu[data-open='true'] .menu-item {
      animation: none;
    }
  }
</style>

<script>
  function initHeader() {
    const header = document.getElementById('site-header');
    const toggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');

    /* ---- frosted-on-scroll ------------------------------------------------ */
    if (header) {
      let ticking = false;
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          header.dataset.stuck = String(window.scrollY > 12);
          ticking = false;
        });
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    }

    /* ---- mobile menu ------------------------------------------------------ */
    if (!toggle || !menu) return;

    const openIcon = toggle.querySelector('.menu-open-icon');
    const closeIcon = toggle.querySelector('.menu-close-icon');
    let lastFocused: HTMLElement | null = null;

    const setOpen = (open: boolean) => {
      menu.classList.toggle('hidden', !open);
      menu.dataset.open = String(open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
      openIcon?.classList.toggle('hidden', open);
      closeIcon?.classList.toggle('hidden', !open);
      // Prevent the page behind the panel from scrolling.
      document.body.style.overflow = open ? 'hidden' : '';

      if (open) {
        lastFocused = document.activeElement as HTMLElement;
        menu.querySelector<HTMLElement>('a, button')?.focus();
      } else {
        lastFocused?.focus();
      }
    };

    toggle.addEventListener('click', () => setOpen(menu.classList.contains('hidden')));

    menu.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      if (target.closest('[data-close]') || target.closest('a')) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !menu.classList.contains('hidden')) setOpen(false);
    });

    // Close when the viewport grows past the mobile breakpoint.
    window.matchMedia('(min-width: 1024px)').addEventListener('change', (event) => {
      if (event.matches && !menu.classList.contains('hidden')) setOpen(false);
    });
  }

  initHeader();
  // Re-initialise after client-side navigations.
  document.addEventListener('astro:after-swap', initHeader);
</script>
