---
/** Back-to-top control. Hidden until the visitor is a screen or so down. */
import Icon from '@/components/ui/Icon.astro';
---

<button
  type="button"
  id="scroll-to-top"
  class="glass fixed bottom-6 right-6 z-50 grid h-11 w-11 translate-y-3 place-items-center rounded-full text-body opacity-0 shadow-float transition-[opacity,transform] duration-300 ease-[var(--ease-quint)] hover:-translate-y-0.5 hover:text-accent data-[visible=true]:translate-y-0 data-[visible=true]:opacity-100"
  aria-label="Scroll back to top"
  data-visible="false"
  tabindex="-1"
>
  <Icon name="arrow-right" size={18} class="-rotate-90" />
</button>

<script>
  const button = document.getElementById('scroll-to-top');

  if (button) {
    // Keep the button out of the tab order while it is invisible.
    const setVisible = (visible: boolean) => {
      button.dataset.visible = String(visible);
      button.tabIndex = visible ? 0 : -1;
    };

    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        setVisible(window.scrollY > window.innerHeight * 0.75);
        ticking = false;
      });
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    button.addEventListener('click', () => {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
      // Return focus to the top of the document for keyboard users.
      document.getElementById('main')?.focus({ preventScroll: true });
    });
  }
</script>
