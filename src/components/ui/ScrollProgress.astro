---
/**
 * Reading/scroll progress bar pinned under the header.
 *
 * Uses the CSS `animation-timeline: scroll()` where supported (zero JS, runs
 * off the main thread) and falls back to a passive scroll listener elsewhere.
 */
---

<div
  class="progress-track pointer-events-none fixed inset-x-0 top-0 z-[70] h-[2px] bg-transparent"
  aria-hidden="true"
>
  <div id="scroll-progress" class="progress-bar h-full w-full origin-left"></div>
</div>

<style>
  .progress-bar {
    background: linear-gradient(90deg, var(--c-accent), var(--c-second));
    transform: scaleX(var(--progress, 0));
    box-shadow: 0 0 12px var(--c-accent-ring);
  }

  /* Modern path: scroll-driven animation, no JavaScript involved. */
  @supports (animation-timeline: scroll()) {
    .progress-bar {
      transform: scaleX(0);
      animation: progress-grow linear both;
      animation-timeline: scroll(root block);
    }
  }

  @keyframes progress-grow {
    to {
      transform: scaleX(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .progress-bar {
      transition: none;
    }
  }
</style>

<script>
  // Fallback for browsers without scroll-driven animations.
  if (!CSS.supports('animation-timeline: scroll()')) {
    const bar = document.getElementById('scroll-progress');

    if (bar) {
      let ticking = false;

      const update = () => {
        const doc = document.documentElement;
        const max = doc.scrollHeight - doc.clientHeight;
        const ratio = max > 0 ? doc.scrollTop / max : 0;
        bar.style.setProperty('--progress', String(Math.min(1, Math.max(0, ratio))));
        ticking = false;
      };

      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      };

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      update();
    }
  }
</script>
