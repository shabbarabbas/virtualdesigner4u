---
/**
 * Button / link primitive.
 *
 * Renders an <a> when `href` is set and a <button> otherwise, so semantics
 * always match behaviour. External links get rel/target and a trailing icon
 * automatically.
 */
import Icon from '@/components/ui/Icon.astro';
import { href as buildHref, cx } from '@/lib/utils';
import type { IconName } from '@/types';

interface Props {
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  variant?: 'primary' | 'secondary' | 'ghost' | 'outline';
  size?: 'sm' | 'md' | 'lg';
  icon?: IconName;
  iconPosition?: 'left' | 'right';
  full?: boolean;
  disabled?: boolean;
  class?: string;
  'aria-label'?: string;
  [key: string]: unknown;
}

const {
  href,
  type = 'button',
  variant = 'primary',
  size = 'md',
  icon,
  iconPosition = 'right',
  full = false,
  disabled = false,
  class: className = '',
  ...rest
} = Astro.props;

const isExternal = Boolean(href && /^https?:\/\//.test(href));

const base =
  'group relative inline-flex items-center justify-center gap-2 rounded-full font-semibold ' +
  'transition-[transform,background-color,border-color,color,box-shadow] duration-200 ease-[var(--ease-quint)] ' +
  'active:translate-y-px disabled:pointer-events-none disabled:opacity-50 whitespace-nowrap';

const variants: Record<string, string> = {
  // Solid accent — the single highest-emphasis action on any given screen.
  primary:
    'bg-accent text-accent-contrast shadow-[0_1px_0_0_rgba(255,255,255,0.25)_inset,var(--shadow-md)] ' +
    'hover:bg-accent-hover hover:-translate-y-0.5 hover:shadow-ember',
  secondary:
    'bg-overlay-strong text-body border border-line-strong backdrop-blur-sm ' +
    'hover:bg-overlay hover:border-accent/50 hover:-translate-y-0.5',
  outline:
    'border border-line-strong text-body hover:border-accent hover:text-accent hover:-translate-y-0.5',
  ghost: 'text-muted hover:text-body hover:bg-overlay',
};

const sizes: Record<string, string> = {
  sm: 'h-9 px-4 text-[0.8rem]',
  md: 'h-11 px-5 text-[0.9rem]',
  lg: 'h-13 px-7 text-[0.95rem]',
};

const classes = cx(base, variants[variant], sizes[size], full && 'w-full', className);
const iconSize = size === 'sm' ? 15 : size === 'lg' ? 19 : 17;
const resolvedIcon: IconName | undefined = icon ?? (isExternal ? 'arrow-up-right' : undefined);
---

{
  href ? (
    <a
      href={isExternal ? href : buildHref(href)}
      class={classes}
      {...(isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
      {...rest}
    >
      {resolvedIcon && iconPosition === 'left' && (
        <Icon name={resolvedIcon} size={iconSize} class="transition-transform duration-200 group-hover:-translate-x-0.5" />
      )}
      <slot />
      {resolvedIcon && iconPosition === 'right' && (
        <Icon name={resolvedIcon} size={iconSize} class="transition-transform duration-200 group-hover:translate-x-0.5" />
      )}
    </a>
  ) : (
    <button type={type} class={classes} disabled={disabled} {...rest}>
      {resolvedIcon && iconPosition === 'left' && (
        <Icon name={resolvedIcon} size={iconSize} class="transition-transform duration-200 group-hover:-translate-x-0.5" />
      )}
      <slot />
      {resolvedIcon && iconPosition === 'right' && (
        <Icon name={resolvedIcon} size={iconSize} class="transition-transform duration-200 group-hover:translate-x-0.5" />
      )}
    </button>
  )
}
