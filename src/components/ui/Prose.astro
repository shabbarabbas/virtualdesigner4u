---
/**
 * Typographic wrapper for rendered Markdown/MDX bodies.
 *
 * Written as scoped CSS with :global() rather than a plugin so the styles
 * inherit the theme tokens directly and stay in sync with light/dark mode.
 */
import { cx } from '@/lib/utils';

interface Props {
  size?: 'base' | 'lg';
  class?: string;
}

const { size = 'base', class: className = '' } = Astro.props;
---

<div class={cx('prose', size === 'lg' && 'prose-lg', className)}>
  <slot />
</div>

<style>
  .prose {
    color: var(--c-text-muted);
    font-size: 1rem;
    line-height: 1.75;
    max-width: 68ch;
  }

  .prose-lg {
    font-size: 1.06rem;
    line-height: 1.78;
  }

  .prose > :global(* + *) {
    margin-top: 1.25em;
  }

  /* Headings ------------------------------------------------------------ */
  .prose :global(h2),
  .prose :global(h3),
  .prose :global(h4) {
    color: var(--c-text);
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.25;
    scroll-margin-top: calc(var(--header-h) + 2rem);
  }

  .prose > :global(h2) {
    margin-top: 2.4em;
    font-size: 1.55em;
  }

  .prose > :global(h3) {
    margin-top: 2em;
    font-size: 1.25em;
  }

  .prose > :global(h4) {
    margin-top: 1.8em;
    font-size: 1.06em;
  }

  /* Anchor links appear on hover; hidden from the a11y tree. */
  .prose :global(h2 > a),
  .prose :global(h3 > a) {
    color: inherit;
    text-decoration: none;
  }

  /* Text ---------------------------------------------------------------- */
  .prose :global(strong) {
    color: var(--c-text);
    font-weight: 600;
  }

  .prose :global(em) {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.05em;
    color: var(--c-text);
  }

  .prose :global(a) {
    color: var(--c-accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    transition: color var(--dur-fast) ease;
  }

  .prose :global(a:hover) {
    color: var(--c-accent-hover);
  }

  /* Lists --------------------------------------------------------------- */
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.4em;
    display: flex;
    flex-direction: column;
    gap: 0.55em;
  }

  .prose :global(ul) {
    list-style: disc;
  }

  .prose :global(ol) {
    list-style: decimal;
  }

  .prose :global(li::marker) {
    color: var(--c-accent);
  }

  .prose :global(li > ul),
  .prose :global(li > ol) {
    margin-top: 0.55em;
  }

  /* Blockquote ---------------------------------------------------------- */
  .prose :global(blockquote) {
    border-left: 2px solid var(--c-accent);
    background: var(--c-overlay);
    border-radius: 0 0.75rem 0.75rem 0;
    padding: 1rem 1.25rem;
    color: var(--c-text);
    font-family: var(--font-serif);
    font-size: 1.1em;
    line-height: 1.6;
  }

  .prose :global(blockquote p + p) {
    margin-top: 0.75em;
  }

  /* Code ---------------------------------------------------------------- */
  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.86em;
    background: var(--c-overlay-strong);
    border: 1px solid var(--c-line);
    border-radius: 0.375rem;
    padding: 0.12em 0.4em;
    color: var(--c-text);
  }

  .prose :global(pre) {
    border: 1px solid var(--c-line);
    border-radius: var(--radius-card);
    padding: 1.1rem 1.25rem;
    overflow-x: auto;
    font-size: 0.86em;
    line-height: 1.65;
    tab-size: 2;
  }

  /* Reset the inline-code chrome inside fenced blocks. */
  .prose :global(pre code) {
    background: none;
    border: none;
    padding: 0;
    font-size: inherit;
  }

  /* Shiki emits both themes; swap them with the theme attribute. */
  :global([data-theme='light']) .prose :global(.astro-code),
  :global([data-theme='light']) .prose :global(.astro-code span) {
    color: var(--shiki-light) !important;
    background-color: var(--shiki-light-bg) !important;
  }

  /* Media --------------------------------------------------------------- */
  .prose :global(img),
  .prose :global(video) {
    border-radius: var(--radius-card);
    border: 1px solid var(--c-line);
    width: 100%;
  }

  .prose :global(figure figcaption) {
    margin-top: 0.7em;
    font-size: 0.82em;
    color: var(--c-text-subtle);
    text-align: center;
  }

  /* Tables -------------------------------------------------------------- */
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92em;
    display: block;
    overflow-x: auto;
  }

  .prose :global(th),
  .prose :global(td) {
    border-bottom: 1px solid var(--c-line);
    padding: 0.7em 0.9em;
    text-align: left;
  }

  .prose :global(th) {
    color: var(--c-text);
    font-weight: 600;
    white-space: nowrap;
  }

  .prose :global(hr) {
    border: 0;
    border-top: 1px solid var(--c-line);
    margin-block: 2.5em;
  }
</style>
