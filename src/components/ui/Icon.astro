---
/**
 * Inline SVG icon set.
 *
 * Icons are inlined (rather than sprited or loaded from a package) so there
 * is zero runtime cost, no extra network request, and `currentColor` makes
 * every icon theme-aware automatically.
 *
 * Stroke icons use a 24×24 grid at 1.6 stroke width; brand marks are filled
 * paths on the same grid so optical sizing stays consistent.
 */
import type { IconName } from '@/types';

interface Props {
  name: IconName;
  size?: number | string;
  class?: string;
  /**
   * Decorative by default. Pass a label when the icon is the only content of
   * an interactive element, which switches it to role="img".
   */
  label?: string;
  strokeWidth?: number;
}

const { name, size = 20, class: className = '', label, strokeWidth = 1.6 } = Astro.props;

/** Brand marks are filled; everything else is stroked. */
