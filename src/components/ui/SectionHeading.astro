---
/**
 * Section heading block — kicker, title, optional lead paragraph and an
 * optional trailing action. Keeps vertical rhythm identical site-wide.
 */
import { cx } from '@/lib/utils';

interface Props {
  kicker?: string;
  title: string;
  /** Words wrapped in `*asterisks*` render in the accent serif. */
  lead?: string;
  align?: 'left' | 'center';
  /** Heading level — pages already have an h1, so sections default to h2. */
  as?: 'h1' | 'h2' | 'h3';
  size?: 'md' | 'lg';
  id?: string;
  class?: string;
}

const {
  kicker,
  title,
  lead,
  align = 'left',
  as: Tag = 'h2',
  size = 'md',
  id,
  class: className = '',
}: Props = Astro.props;

/**
 * Allow a single emphasised phrase per heading using *asterisk* syntax.
 * Escaping is unnecessary because `title` is author-controlled config/content,
 * never user input — but we still build the markup from split parts rather
 * than injecting raw HTML.
 */
const parts = title.split(/(\*[^*]+\*)/g).filter(Boolean);
const hasAction = Astro.slots.has('action');
---

<div
  class={cx(
    'flex flex-col gap-5',
    align === 'center' && 'items-center text-center',
    hasAction && 'md:flex-row md:items-end md:justify-between md:gap-10',
    className,
  )}
>
  <div class={cx('flex flex-col gap-4', align === 'center' && 'items-center', 'max-w-2xl')}>
    {kicker && <span class="kicker" data-reveal>{kicker}</span>}

    <Tag
      id={id}
      class={cx(
        'font-display text-body',
        size === 'lg' ? 'text-h1' : 'text-h2',
      )}
      data-reveal
      style="--reveal-delay:60ms"
    >
      {
        parts.map((part) =>
          part.startsWith('*') && part.endsWith('*') ? (
            <span class="text-accent-serif">{part.slice(1, -1)}</span>
          ) : (
            <Fragment>{part}</Fragment>
          ),
        )
      }
    </Tag>

    {
      lead && (
        <p class="text-lead text-muted" data-reveal style="--reveal-delay:120ms">
          {lead}
        </p>
      )
    }
  </div>

  {
    hasAction && (
      <div class="shrink-0" data-reveal style="--reveal-delay:180ms">
        <slot name="action" />
      </div>
    )
  }
</div>
