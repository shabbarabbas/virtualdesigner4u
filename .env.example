# -----------------------------------------------------------------------------
# Copy to `.env` and fill in. Never commit `.env` — this directory is a public
# web root, so anything committed here is downloadable.
#
# Only variables prefixed with PUBLIC_ are exposed to client-side code.
# -----------------------------------------------------------------------------

# Canonical origin used for canonical URLs, sitemap, RSS and JSON-LD.
SITE_URL=https://virtualdesigner4u.com

# Base path. Use "/" for a custom domain or a user site.
# For a project site served at username.github.io/repo-name use "/repo-name".
BASE_PATH=/

# Contact form credential.
# Web3Forms  -> your access key from https://web3forms.com
# Formspree  -> the full endpoint, e.g. https://formspree.io/f/xxxxxxx
# FormSubmit -> the email address or hashed string
PUBLIC_FORM_ENDPOINT=
